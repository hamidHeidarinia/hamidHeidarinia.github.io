<!-- ============ EXPERIENCE ============ -->
<div
    class="px-4 sm:px-8 md:px-16 py-6 sm:py-8 border-b border-slate-200 dark:border-slate-800 transition-colors duration-300"
>
    <h2
        class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-5 sm:mb-6"
    >
        Experience
    </h2>

    <!-- SaaS Stealth Startup -->
    <div class="flex gap-3 sm:gap-4" x-data="{ expanded: false }">
        <svg
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-md flex items-center justify-center text-white font-bold shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 100 100"
            width="100"
            height="100"
        >
            <defs>
                <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#ff8a00"></stop>
                    <stop offset="48%" stop-color="#f04432"></stop>
                    <stop offset="100%" stop-color="#2832a8"></stop>
                </linearGradient>
            </defs>

            <rect x="4" y="4" width="92" height="92" rx="8" fill="url(#bg)"
            ></rect>

            <!-- white logo -->
            <circle
                cx="50"
                cy="39"
                r="15"
                fill="none"
                stroke="#fff"
                stroke-width="7"></circle>
            <path
                d="M35 61
                                                            C37 70, 43 75, 50 75
                                                            C57 75, 63 70, 65 61"
                fill="none"
                stroke="#fff"
                stroke-width="7"
                stroke-linecap="butt"
                stroke-linejoin="round"></path>
        </svg>
        <div class="flex-1 min-w-0">
            <p
                class="font-semibold text-slate-900 dark:text-white text-sm sm:text-base"
            >
                Founder & Lead Software Engineer
            </p>
            <p class="text-slate-700 dark:text-slate-300 text-sm sm:text-base">
                SaaS Stealth Startup &nbsp;•&nbsp; Self-employed
            </p>
            <p
                class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5"
                id="firstRecord"
                x-init="document.getElementById('firstRecord').innerHTML = formatDateRange('2022-01-01')"
            >
            </p>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                East Azerbaijan Province, Iran &nbsp;•&nbsp; On-site
            </p>

            <div
                class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed mt-3 space-y-3 max-w-3xl"
            >
                <p>
                    As the Founder and Lead Software Engineer, I have been
                    leading the end-to-end Software Development Life Cycle
                    (SDLC) for my startup since 2022. I am responsible for
                    product architecture, technical strategy, backend
                    engineering, database architecture and administration (DBA),
                    cloud infrastructure, DevOps, CI/CD, security, performance
                    optimization, and scalable system design. The product is
                    currently under active development and has not yet been
                    publicly launched.
                </p>

                <p x-show="expanded" x-cloak x-transition>
                    Designed and developed the software infrastructure for
                    products from concept to implementation. Conducted technical
                    research and feasibility studies to evaluate alternative
                    solutions. Optimized SQL queries, stored procedures, views,
                    and indexes to improve database and application performance.
                    Designed system architecture, data models, and RESTful APIs.
                    Developed backend services using Laravel. Managed the
                    product development lifecycle using Agile/Scrum
                    methodologies. Documented, tested, and optimized various
                    components of software systems. Led Research and Development
                    (R&D) initiatives focused on technology and product
                    innovation.
                </p>

                <p
                    x-show="!expanded"
                    class="text-slate-500 dark:text-slate-500"
                >
                    Designed and developed...
                </p>
            </div>
            <br />
            <button
                @click="expanded = !expanded"
                class="border border-slate-800 px-[1rem] py-[.5rem] focus-ring flex items-center gap-1 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white rounded-full"
            >
                <span x-text="expanded ? 'Show less' : 'Show More'"></span>
                <svg
                    class="w-4 h-4 transition-transform"
                    :class="expanded && 'rotate-180'"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M6 9l6 6 6-6"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Senior Backend Software Engineer | Technical Team Lead | Database Administrator (DBA) -->
    <div class="flex gap-3 sm:gap-4 mt-5" x-data="{ expanded: false }">
        <svg
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-md flex items-center justify-center text-white font-bold shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 100 100"
        >
            <circle cx="50" cy="50" r="50" fill=""></circle>
            <g stroke-linejoin="round">
                <polygon
                    points="44,28 37,36.9 37.9,61.9 49.9,39"
                    fill="#969696"
                    stroke="#969696"
                    stroke-width="0.6"></polygon>
                <polygon
                    points="38.2,34.2 17,64.9 21.9,73.9 35.9,63.4 38.6,64.2 36.4,62"
                    fill="#626262"
                    stroke="#626262"
                    stroke-width="0.6"></polygon>
                <polygon
                    points="54.6,24.2 56,28 51,39 62,59.9 61.2,64.2 63.9,59 64,39"
                    fill="#626262"
                    stroke="#626262"
                    stroke-width="0.6"></polygon>
                <polygon
                    points="49.9,19 42.6,28.6 50,39 36.5,62 51,69.9 62.4,61.9 50.9,39 55.9,26.9"
                    fill="#7b7b7b"
                    stroke="#7b7b7b"
                    stroke-width="0.6"></polygon>
                <polygon
                    points="55.6,25.2 64,38.9 64,59 50.1,70.9 63,63.9 78.6,74.2 83.9,65.9"
                    fill="#505050"
                    stroke="#505050"
                    stroke-width="0.6"></polygon>
            </g>
        </svg>

        <div class="flex-1 min-w-0">
            <p
                class="font-semibold text-slate-900 dark:text-white text-sm sm:text-base"
            >
                Senior Backend Software Engineer | Technical Team Lead |
                Database Administrator (DBA)
            </p>
            <p class="text-slate-700 dark:text-slate-300 text-sm sm:text-base">
                Stealth Startup &nbsp;•&nbsp; إFull-time
            </p>
            <p
                class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5"
                id="secondRecord"
                x-init="document.getElementById('secondRecord').innerHTML = formatDateRange('2019-08-01', '2022-03-31')"
            >
            </p>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                Scotland, United Kingdom &nbsp;•&nbsp; Remote
            </p>

            <div
                class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed mt-3 space-y-3 max-w-3xl"
            >
                <p>
                    Building a scalable software platform for restaurants and
                    takeaway businesses, including EPOS, online ordering,
                    restaurant management, payment integration, digital
                    marketing, and 24/7 technical support.
                </p>
                <p class="">
                    Software Developer (Full Stack / Backend Developer)
                    Designed, developed, and maintained web-based applications
                    using ASP.NET MVC. Designed and implemented RESTful APIs for
                    communication between services and client applications.
                </p>
                <div x-show="expanded" x-cloak x-transition>
                    <p class="">
                        Developed new features based on business requirements.
                        Troubleshot, debugged, and enhanced the performance of
                        existing systems. Collaborated in requirements analysis,
                        technical design, and project planning.
                    </p>
                    <p class="my-2">
                        Backend Team Lead Led the backend development team in
                        designing, developing, and maintaining software systems.
                        Planned, prioritized, and assigned tasks among team
                        members. Contributed to software architecture design and
                        technical decision-making. Designed, implemented, and
                        optimized Microsoft SQL Server databases. Conducted code
                        reviews and ensured adherence to software development
                        standards and best practices. Mentored team members and
                        supported their technical growth. Participated in
                        requirements analysis and translated business needs into
                        practical technical solutions.
                    </p>
                    <p class="my-2">
                        Senior Software Developer, Technical Team Lead &
                        Database Administrator (DBA) Designed, implemented, and
                        administered Microsoft SQL Server databases. Designed
                        data models and database architectures aligned with
                        business requirements. Optimized queries, stored
                        procedures, views, and indexes to improve system
                        performance. Monitored database performance and resolved
                        performance bottlenecks. Designed and managed database
                        backup and recovery strategies. Managed database
                        security, user permissions, and data integrity.
                        Diagnosed and resolved database-related issues in
                        production environments. Led the software development
                        team and coordinated technical activities across
                        projects. Planned, delegated, and monitored project
                        tasks to ensure timely delivery.
                    </p>
                </div>

                <p
                    x-show="!expanded"
                    class="text-slate-500 dark:text-slate-500"
                >
                    Developed new features based on business...
                </p>
            </div>
            <br />
            <button
                @click="expanded = !expanded"
                class="border border-slate-800 px-[1rem] py-[.5rem] focus-ring flex items-center gap-1 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white rounded-full"
            >
                <span x-text="expanded ? 'Show less' : 'Show More'"></span>
                <svg
                    class="w-4 h-4 transition-transform"
                    :class="expanded && 'rotate-180'"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M6 9l6 6 6-6"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Full-Stack Web Developer -->
    <div class="flex gap-3 sm:gap-4 mt-5" x-data="{ expanded: false }">
        <svg
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-md flex items-center justify-center text-white font-bold shrink-0"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 128 128"
            id="company-accent-4"
        >
            <path fill="#e7e2dc" d="M0 0h128v128H0z"></path>
            <path fill="#9db3c8" d="M48 16h64v112H48z"></path>
            <path fill="#788fa5" d="M16 80h32v48H16z"></path>
            <path fill="#56687a" d="M48 80h32v48H48z"></path>
        </svg>
        <div class="flex-1 min-w-0">
            <p
