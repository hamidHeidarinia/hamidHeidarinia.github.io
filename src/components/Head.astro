---
// Component Script (JavaScript)
import "../styles/app.css";

import { Font, Image } from "astro:assets";
// import { Image } from "astro:assets";
import Favicon from "../assets/icons/favicon.ico";
import Favicon32 from "../assets/icons/favicon-hamidHeidarinia-32x32.webp";
import Favicon16 from "../assets/icons/favicon-hamidHeidarinia--16x16.webp";
import AppleTouchIcon from "../assets/icons/apple-touch-icon-hamidHeidarinia.webp";
import OgCover from "../assets/icons/hamid-heidarinia-profile-badge-builder-1280x720.webp";
const siteUrl = Astro.site;
import type { Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const lang = Astro.currentLocale ?? "en";
const manifest = `/manifest-${lang}.webmanifest`;
---

<head>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t("head.description")} />
    <meta name="keywords" content={t("head.keywords")} />
    <meta name="author" content={t("site.name")} />
    <title>{t("site.name")} — {t("site.tagline")}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta
        property="og:site_name"
        content={new URL(Astro.url.pathname, Astro.site)}
    />
    <meta
        property="og:title"
        content={t("site.name") + " — " + t("site.tagline")}
    />
    <meta property="og:description" content={t("head.description")} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={OgCover.src} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- <meta property="og:locale" content="fa_IR"> -->

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#5FB5D8" />
    <link rel="apple-touch-icon" href={AppleTouchIcon.src} />

    <!-- PWA -->
    <meta name="theme-color" content="#5FB5D8" />
    <meta name="background-color" content="#5FB5D8" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- iOS -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta
        name="apple-mobile-web-app-title"
        content={t("site.name") + " — " + t("site.tagline")}
    />

    <!-- Manifest -->
    <!-- <link rel="manifest" href="./manifest.json" /> -->
    <link rel="manifest" href={manifest} />

    <!-- icons -->
    <link rel="icon" href={Favicon.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={AppleTouchIcon.src} />
    <link rel="icon" type="image/png" sizes="32x32" href={Favicon32.src} />
    <link rel="icon" type="image/png" sizes="16x16" href={Favicon16.src} />
    <!-- <link rel="manifest" href="/site.webmanifest" /> -->

    <!-- <script src="./assets/lib/tailwindcss.js"></script> -->

    <link rel="manifest" href="./manifest.webmanifest" />
    <link rel="sitemap" href="./sitemap-index.xml" />

    <!-- <link
        rel="preload"
        href="./assets/fonts/IRANSans/IRANSANSWEB.woff2"
        as="font"
        type="font/woff2"
        crossorigin
    />
    <link
        rel="preload"
        href="./assets/fonts/Calibri/calibri-regular.woff2"
        as="font"
        type="font/woff2"
        crossorigin
    /> -->
    <Font cssVariable="--font-calibri" />

    <!-- <link rel="stylesheet" href="./assets/css/app.css" /> -->

    <script is:inline>
        // set theme before paint to avoid flash
        if (
            localStorage.getItem("theme") === "dark" ||
            (!("theme" in localStorage) &&
                window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
            document.documentElement.classList.add("dark");
        }
    </script>
</head>
