                                                ></path>
                                            </svg>
                                            <div class="">
                                                <p
                                                    class="font-bold text-slate-900 leading-tight dark:text-slate-300"
                                                >
                                                    {
                                                        t(
                                                            "header.contact.info.birthday",
                                                        )
                                                    }
                                                </p>
                                                <p
                                                    class="text-[15px] text-slate-900 dark:text-slate-300"
                                                >
                                                    {
                                                        t(
                                                            "header.contact.info.birthday.date",
                                                        )
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 mt-4">
                <a
                    href="https://www.linkedin.com/in/hamidheidarinia/"
                    target="_blank"
                    class="focus-ring bg-blue-600 hover:bg-blue-700 active:bg-blue-800 dark:bg-blue-500 dark:hover:bg-blue-400 text-white text-sm font-semibold px-[1rem] py-[.6rem] rounded-full transition shadow-sm"
                >
                    {t("header.join.btn.title")}
                </a>
                <a
                    href="#"
                    class="focus-ring border border-blue-600 dark:border-blue-400 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-slate-800 active:bg-blue-100 text-sm font-semibold px-[1rem] py-[.5rem] rounded-full transition"
                >
                    {t("header.download.cv.btn.title")}
                </a>
            </div>
        </div>

        <!-- right: affiliations -->
        <div
            class="flex flex-col gap-3.5 sm:gap-4 md:min-w-[300px] md:max-w-[320px]"
        >
            <div class="flex items-center gap-3">
                <svg
                    class="w-9 h-9"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 100 100"
                    width="100"
                    height="100"
                >
                    <defs>
                        <linearGradient
                            id="bg"
                            x1="0%"
                            y1="0%"
                            x2="100%"
                            y2="0%"
                        >
                            <stop offset="0%" stop-color="#ff8a00"></stop>
                            <stop offset="48%" stop-color="#f04432"></stop>
                            <stop offset="100%" stop-color="#2832a8"></stop>
                        </linearGradient>
                    </defs>

                    <rect
                        x="4"
                        y="4"
                        width="92"
                        height="92"
                        rx="8"
                        fill="url(#bg)"></rect>

                    <!-- white logo -->
                    <circle
                        cx="50"
                        cy="39"
