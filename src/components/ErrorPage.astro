---
import "../styles/app.css";
import { errors, locales, rtlLocales } from "../i18n/errors";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>404</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Vazirmatn:wght@400;600;700;900&family=Noto+Sans+Old+Turkic&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-6 relative overflow-hidden"
  >
    <div
      class="absolute inset-0 opacity-20"
      style="background-image: radial-gradient(circle, #64748b 1px, transparent 1px); background-size: 32px 32px;"
    >
    </div>
    <div
      class="pointer-events-none absolute top-1/4 -left-40 w-96 h-96 bg-violet-600/30 rounded-full blur-3xl glow"
    >
    </div>
    <div
      class="pointer-events-none absolute bottom-1/4 -right-40 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl glow"
      style="animation-delay: 1.5s;"
    >
    </div>

    <main class="relative z-10 w-full max-w-lg text-center">
      <div class="relative mb-6 select-none" dir="ltr">
        <h1
          class="text-[9rem] sm:text-[11rem] leading-none font-black tracking-tighter bg-clip-text text-transparent bg-gradient-to-b from-white to-slate-600"
        >
          404
        </h1>
        <div
          class="absolute inset-0 flex items-center justify-center pointer-events-none"
        >
          <svg
            class="w-20 h-20 sm:w-24 sm:h-24 text-violet-400/80 float"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 17.25h.007v.008H12v-.008Z"></path>
          </svg>
        </div>
      </div>

      <h2 id="title" class="text-2xl sm:text-3xl font-bold text-white mb-3">
      </h2>
      <p id="text" class="text-slate-400 leading-7 mb-10 max-w-sm mx-auto"></p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          id="home"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-white hover:bg-slate-200 transition-colors px-7 py-3.5 font-semibold text-slate-900 shadow-xl shadow-white/10 cursor-pointer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"
            ></path>
          </svg>
          <span id="home-label"></span>
        </a>
        <button
          id="back"
          type="button"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-slate-800/60 hover:bg-slate-800 active:bg-slate-900 transition-colors px-7 py-3.5 font-semibold text-slate-200 border border-slate-700 backdrop-blur cursor-pointer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 rtl:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
          </svg>
          <span id="back-label"></span>
        </button>
      </div>

      <div
        class="mt-12 pt-6 border-t border-slate-800/80 flex items-center justify-center gap-6 text-md"
      >
        <a
          id="home2"
          class="text-slate-500 hover:text-slate-300 transition-colors"></a>
        <span class="w-1 h-1 rounded-full bg-slate-700"></span>
        <a
          id="skills"
          class="text-slate-500 hover:text-slate-300 transition-colors"></a>
      </div>
    </main>

    <script is:inline define:vars={{ errors, locales, rtlLocales, base }}>
      const path = location.pathname.startsWith(base)
        ? location.pathname.slice(base.length)
        : location.pathname;
      const seg = path.split("/").filter(Boolean)[0];
      const lang = locales.includes(seg) ? seg : "en";
      const t = errors[lang];
      const en = errors.en;
      const pick = (k) => t[k] ?? en[k];

      const root = document.documentElement;
      root.lang = lang;
      root.dir = rtlLocales.includes(lang) ? "rtl" : "ltr";
      root.dataset.lang = lang;

      document.title = "404 - " + t["404"].title;
      document.getElementById("title").textContent = t["404"].title;
      document.getElementById("text").textContent = t["404"].text;

      const homeHref = base + "/" + lang + "/";
      document.getElementById("home").href = homeHref;
      document.getElementById("home-label").textContent = t.home;
      document.getElementById("home2").href = homeHref;
      document.getElementById("home2").textContent = t.home;
      document.getElementById("skills").href = base + "/" + lang + "/skills";
      document.getElementById("skills").textContent = pick("skills");
      document.getElementById("back-label").textContent = pick("back");
      document
        .getElementById("back")
        .addEventListener("click", () => history.back());

      const m = document.createElement("link");
      m.rel = "manifest";
      m.href = base + "/manifest-" + lang + ".webmanifest";
      document.head.appendChild(m);
    </script>
  </body>
</html>

<style is:global>
  body {
    font-family: "Inter", sans-serif;
  }
  html[dir="rtl"] body {
    font-family: "Vazirmatn", "Inter", sans-serif;
  }
  html[data-lang="otk"] body {
    font-family: "Noto Sans Old Turkic", "Inter", sans-serif;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-16px);
    }
  }
  .float {
    animation: float 5s ease-in-out infinite;
  }

  @keyframes glow {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }
  .glow {
    animation: glow 3s ease-in-out infinite;
  }
</style>
