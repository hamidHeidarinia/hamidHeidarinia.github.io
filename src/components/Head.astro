---
import "../styles/app.css";
import { Font } from "astro:assets";
import Favicon from "../assets/icons/favicon.ico";
import Favicon32 from "../assets/icons/favicon-hamidHeidarinia-32x32.webp";
import Favicon16 from "../assets/icons/favicon-hamidHeidarinia--16x16.webp";
import AppleTouchIcon from "../assets/icons/apple-touch-icon-hamidHeidarinia.webp";
import OgCover from "../assets/icons/hamid-heidarinia-profile-badge-builder-1280x720.webp";
import type { Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const lang = Astro.currentLocale ?? "en";

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(OgCover.src, site);
const title = `${t("site.name")} — ${t("site.tagline")}`;
const manifest = `/manifest-${lang}.webmanifest`;

const hreflangs = {
    en: "en-US",
    az: "az-Latn-AZ",
    azarab: "az-Arab-IR",
    tr: "tr-TR",
    otk: "otk",
    fa: "fa-IR",
};
const ogLocales = {
    en: "en_US",
    az: "az_AZ",
    azarab: "az_IR",
    tr: "tr_TR",
    otk: "en_US",
    fa: "fa_IR",
};
// مسیر بدون پیشوند زبان
const path = Astro.url.pathname.replace(/^\/[^/]+/, "");
---

<head>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={t("head.description")} />
    <meta name="keywords" content={t("head.keywords")} />
    <meta name="author" content={t("site.name")} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang -->
    {
        Object.entries(hreflangs).map(([l, code]) => (
            <link
                rel="alternate"
                hreflang={code}
                href={new URL(`/${l}${path}`, site)}
            />
        ))
    }
    <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(`/en${path}`, site)}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t("site.name")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t("head.description")} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="720" />
    <meta
        property="og:locale"
        content={ogLocales[lang as keyof typeof ogLocales]}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={t("head.description")} />
    <meta name="twitter:image" content={ogImage} />

    <!-- PWA / iOS -->
    <meta name="theme-color" content="#5FB5D8" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={title} />
    <link rel="manifest" href={manifest} />

    <!-- Icons -->
    <link rel="icon" href={Favicon.src} sizes="any" />
    <link rel="icon" type="image/webp" sizes="32x32" href={Favicon32.src} />
    <link rel="icon" type="image/webp" sizes="16x16" href={Favicon16.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={AppleTouchIcon.src} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-calibri" />

    <script is:inline>
        if (
            localStorage.getItem("theme") === "dark" ||
            (!("theme" in localStorage) &&
                window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
            document.documentElement.classList.add("dark");
        }
    </script>
</head>
