---
import { useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import CompanyIcon from "./CompanyIcon.astro";

interface Props {
    locale: Locale;
    currentPath: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const currentLocale = Astro.currentLocale;
const homeUrl = getRelativeLocaleUrl(currentLocale, "/");

type Company = "one" | "two" | "three";
const ALL_COMPANIES: Company[] = ["three", "two", "one"];

// اولین شرکت در لیست، همان شرکتی است که در خلاصه (متن کلیک‌شدنی) نمایش داده می‌شود
const skillGroups: {
    title: string;
    skills: { title: string; companies: Company[] }[];
}[] = [
    {
        title: "Backend / Software Engineering",
        skills: [
            { title: "Backend Development", companies: ["three", "two", "one"] },
            { title: "Software Architecture", companies: ["three"] },
            { title: "RESTful APIs", companies: ["three"] },
            { title: "API Development", companies: ["three"] },
            { title: "PHP", companies: ["three", "one"] },
            { title: "Laravel", companies: ["three", "one"] },
            { title: "Python", companies: ["three"] },
            { title: "Django", companies: ["three"] },
            { title: "C#", companies: ["two"] },
            { title: "ASP.NET MVC", companies: ["two"] },
            { title: "Object-Oriented Programming (OOP)", companies: ["three", "two"] },
            { title: "SOLID Principles", companies: ["three"] },
            { title: "Software Design Patterns", companies: ["three", "two"] },
            { title: "Unit Testing", companies: ["three", "one"] },
            { title: "Software Development Life Cycle (SDLC)", companies: ["three"] },
            { title: "GraphQL", companies: ["three"] },
        ],
    },
    {
        title: "Database",
        skills: [
            { title: "SQL", companies: ["three", "two"] },
            { title: "Database Administration", companies: ["three"] },
            { title: "Database Design", companies: ["three"] },
            { title: "Database Architecture", companies: ["three"] },
            { title: "Database Development", companies: ["three"] },
            { title: "Query Optimization", companies: ["three"] },
            { title: "Database Performance Tuning", companies: ["three"] },
            { title: "Stored Procedures", companies: ["three", "two"] },
            { title: "MariaDB", companies: ["three"] },
            { title: "MySQL", companies: ["one"] },
            { title: "PostgreSQL", companies: ["three"] },
            { title: "Microsoft SQL Server", companies: ["two"] },
            { title: "Redis", companies: ["three"] },
            { title: "Neo4j", companies: ["three"] },
            { title: "Couchbase", companies: ["three"] },
        ],
    },
    {
        title: "Infrastructure",
        skills: [
            { title: "Linux", companies: ["three"] },
            { title: "Docker", companies: ["three"] },
            { title: "Git", companies: ["three", "two", "one"] },
            { title: "Github", companies: ["three", "two", "one"] },
            { title: "Gitlab", companies: ["one"] },
            { title: "Deployment", companies: ["three", "one"] },
        ],
    },
    {
        title: "Leadership / Product",
        skills: [
            { title: "Technical Leadership", companies: ["two"] },
            { title: "Code Review", companies: ["three", "two"] },
            { title: "Agile", companies: ["three"] },
            { title: "Scrum", companies: ["three"] },
            { title: "Product Ownership", companies: ["three"] },
            { title: "Business Ownership", companies: ["three"] },
            { title: "Product Management", companies: ["three"] },
            { title: "Requirements Analysis", companies: ["three", "two", "one"] },
            { title: "Backlog Management", companies: ["three", "two"] },
            { title: "Technical Documentation", companies: ["three", "two", "one"] },
            { title: "Team Leadership", companies: ["two", "one"] },
        ],
    },
    {
        title: "Frontend Development",
        skills: [
            { title: "HTML5", companies: ["one"] },
            { title: "Cascading Style Sheets (CSS)", companies: ["one"] },
            { title: "Bootstrap (Framework)", companies: ["one"] },
            { title: "Tailwind CSS", companies: ["three"] },
            { title: "JavaScript", companies: ["three", "one"] },
            { title: "jQuery", companies: ["one"] },
        ],
    },
    {
        title: "Collaboration / Communication Tools",
        skills: [
            { title: "Microsoft Teams", companies: ["two"] },
            { title: "Slack", companies: ["two"] },
            { title: "Skype", companies: ["two"] },
            { title: "Zoom", companies: ["two"] },
        ],
    },
];

// به هر skill یک id می‌دهیم و داده‌ی modal را برای Alpine آماده می‌کنیم
const groups = skillGroups.map((g, gi) => ({
    ...g,
    skills: g.skills.map((s, si) => ({ ...s, id: `${gi}-${si}` })),
}));

const modalData = Object.fromEntries(
    groups.flatMap((g) =>
        g.skills
            .filter((s) => s.companies.length > 1)
            .map((s) => [s.id, { title: s.title, companies: s.companies }]),
    ),
);

const totalSkills = groups.reduce((sum, g) => sum + g.skills.length, 0);

// برای بسته بودن اولیه‌ی همه‌ی گروه‌ها، true را به false تغییر بده
// openGroups: ${JSON.stringify(groups.map(() => true))},
const alpineData = `{
    active: null,
    skills: ${JSON.stringify(modalData)},
    openGroups: ${JSON.stringify(groups.map((_, i) => i === 0))},
    toggleGroup(i) { this.openGroups[i] = !this.openGroups[i]; },
    get current() { return this.active ? this.skills[this.active] : null; }
}`;
---
<!-- تعریف یک‌باره‌ی گرادیان آیکن شرکت three -->
<svg width="0" height="0" class="absolute pointer-events-none" aria-hidden="true">
    <defs>
        <linearGradient id="company-three-bg" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ff8a00"></stop>
            <stop offset="48%" stop-color="#f04432"></stop>
            <stop offset="100%" stop-color="#2832a8"></stop>
        </linearGradient>
    </defs>
</svg>

<!-- ============ SKILLS ============ -->
<div
    x-data={alpineData}
    class="px-4 sm:px-8 md:px-16 py-6 sm:py-8 transition-colors duration-300"
>
    <div
        class="mb-6 focus-ring mt-5 sm:mt-6 flex items-center justify-between max-w-4xl transition group"
    >
        <a href={homeUrl} class="flex items-center gap-3 min-w-0">
            <svg
                class="rotate-180 w-5 h-5 sm:w-6 sm:h-6 text-slate-400 dark:fill-slate-300 group-hover:-translate-x-1 transition-transform shrink-0"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 512 512"
                aria-hidden="true"
            >
                <path opacity=".4" fill="" d=""></path>
                <path
                    fill=""
                    d="M505 273c9.4-9.4 9.4-24.6 0-33.9L337 71c-9.4-9.4-24.6-9.4-33.9 0s-9.4 24.6 0 33.9l127 127-406.1 0c-13.3 0-24 10.7-24 24s10.7 24 24 24l406.1 0-127 127c-9.4 9.4-9.4 24.6 0 33.9s24.6 9.4 33.9 0L505 273z"
                ></path>
            </svg>
            <h1 class="text-xl sm:text-3xl font-bold text-slate-900 dark:text-white">
                {t("skills.title")} ({totalSkills})
            </h1>
        </a>
    </div>

    <div class="max-w-4xl">
        {
            groups.map((group, gi) => (
                <section class={gi === 0 ? "" : "mt-4"}>
                    <button
                        type="button"
                        class="w-full flex items-center gap-2 sm:gap-3 mb-4 text-left cursor-pointer group/header"
                        @click={`toggleGroup(${gi})`}
                        :aria-expanded={`openGroups[${gi}]`}
                    >
                        <span class="shrink-0 inline-flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-lg border border-gray-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 group-hover/header:bg-gray-100 dark:group-hover/header:bg-slate-800 transition-colors">
                            <!-- آیکون + (وقتی بسته است) -->
                            <svg
                                x-show={`!openGroups[${gi}]`}
                                class="w-3.5 h-3.5 sm:w-4 sm:h-4"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                aria-hidden="true"
                            >
                                <path d="M12 5v14M5 12h14"></path>
                            </svg>
                            <!-- آیکون − (وقتی باز است) -->
                            <svg
                                x-show={`openGroups[${gi}]`}
                                x-cloak
                                class="w-3.5 h-3.5 sm:w-4 sm:h-4"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14"></path>
                            </svg>
                        </span>
                        <h2 class="text-xl sm:text-2xl md:text-3xl font-bold min-w-0 break-words">
                            {group.title}
                        </h2>
                        <span class="shrink-0 text-xs sm:text-sm text-gray-500 dark:text-slate-400 font-medium">
                            ({group.skills.length})
                        </span>
                    </button>

                    <div x-show={`openGroups[${gi}]`} x-collapse x-cloak>
                        {group.skills.map((skill) => {
                            const [first, ...others] = skill.companies;
                            const hasModal = others.length > 0;

                            return (
                                <div class="border-b border-gray-200 dark:border-slate-700 pb-4 mb-4 px-2 sm:px-4">
                                    <h3 class="text-lg sm:text-xl md:text-2xl text-slate-900 mb-2 dark:text-white break-words">
                                        {skill.title}
                                    </h3>
                                    <div class="flex items-start sm:items-center gap-2">
                                        <CompanyIcon company={first} />
                                        {hasModal ? (
                                            <button
                                                type="button"
                                                class="min-w-0 text-left text-sm sm:text-base text-gray-600 hover:text-blue-600 dark:text-blue-400 font-medium hover:underline cursor-pointer break-words"
                                                data-skill={skill.id}
                                                @click="active = $el.dataset.skill"
                                            >
                                                {skill.companies.length} {t("skill.experience")}{" "}
                                                {t(`experience.${first}.organization`)}{" "}
                                                {t("skill.otherAnd")} {others.length}{" "}
                                                {t("skill.otherCompany")}
                                            </button>
                                        ) : (
                                            <p class="min-w-0 text-sm sm:text-base text-gray-600 dark:text-slate-300 font-medium break-words">
                                                {t(`experience.${first}.job.title`)}
                                                &nbsp;{t("skill.at")}&nbsp;
                                                {t(`experience.${first}.organization`)}
                                            </p>
                                        )}
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                </section>
            ))
        }
    </div>

    <!-- ============ SHARED MODAL (فقط یکی) ============ -->
    <div
        x-show="active"
        x-cloak
        role="dialog"
        aria-modal="true"
        @keydown.escape.window="active = null"
        class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6"
    >
        <!-- overlay -->
        <div
            class="absolute inset-0 bg-black/50"
            x-show="active"
            x-transition.opacity
            @click="active = null"
        ></div>

        <div
            class="relative z-10 w-full max-w-2xl max-h-[90vh] flex flex-col"
            x-show="active"
            x-transition:enter="transition duration-300"
            x-transition:enter-start="transform opacity-0 -translate-y-4"
            x-transition:enter-end="transform opacity-100 translate-y-0"
            x-transition:leave="transition duration-200"
            x-transition:leave-start="transform opacity-100 translate-y-0"
            x-transition:leave-end="transform opacity-0 -translate-y-4"
        >
            <div class="bg-white dark:bg-slate-950 dark:text-slate-300 rounded-2xl shadow-lg border border-gray-200 dark:border-slate-700 flex flex-col overflow-hidden max-h-[90vh]">
                <div class="flex flex-row justify-between items-center gap-3 border-b border-gray-200 dark:border-slate-700 px-4 py-2 text-slate-800">
                    <h2
                        class="min-w-0 text-lg sm:text-2xl font-bold text-gray-900 dark:text-slate-300 break-words"
                        x-text="current?.title"
                    ></h2>
                    <button
                        type="button"
                        @click="active = null"
                        aria-label="Close"
                        class="shrink-0 inline-flex items-center justify-center w-10 h-10 -mr-2 rounded-lg hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors"
                    >
                        <svg
                            class="w-5 h-5 fill-current dark:fill-slate-300"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 640 640"
                            aria-hidden="true"
                        >
                            <path d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z"></path>
                        </svg>
                    </button>
                </div>

                <div class="overflow-y-auto p-3 sm:p-4 bg-white dark:bg-slate-800/95 dark:text-slate-300">
                    <div class="px-2 sm:px-6 py-3 sm:py-5 space-y-4 sm:space-y-6">
                        {
                            ALL_COMPANIES.map((company) => (
                                <div
                                    class="flex items-start sm:items-center gap-2"
                                    x-show={`current?.companies.includes('${company}')`}
                                >
                                    <CompanyIcon company={company} />
                                    <p class="min-w-0 text-sm sm:text-base text-gray-600 dark:text-slate-300 font-medium break-words">
                                        {t(`experience.${company}.job.title`)}
                                        &nbsp;{t("skill.at")}&nbsp;
                                        {t(`experience.${company}.organization`)}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>