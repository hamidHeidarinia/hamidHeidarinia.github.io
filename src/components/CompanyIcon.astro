---
interface Props {
    company: "one" | "two" | "three";
    class?: string;
}
const { company, class: className = "w-6 h-6 sm:w-7 sm:h-7 shrink-0" } =
    Astro.props;
---

{
    company === "three" && (
        <svg
            class={className}
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 100 100"
            aria-hidden="true"
        >
            <rect
                x="4"
                y="4"
                width="92"
                height="92"
                rx="8"
                fill="url(#company-three-bg)"
            />
            <circle
                cx="50"
                cy="39"
                r="15"
                fill="none"
                stroke="#fff"
                stroke-width="7"
            />
            <path
                d="M35 61 C37 70, 43 75, 50 75 C57 75, 63 70, 65 61"
                fill="none"
                stroke="#fff"
                stroke-width="7"
                stroke-linecap="butt"
                stroke-linejoin="round"
            />
        </svg>
    )
}

{
    company === "two" && (
        <svg
            class={className}
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 100 100"
            aria-hidden="true"
        >
            <circle cx="50" cy="50" r="50" fill="" />
            <g stroke-linejoin="round">
                <polygon
                    points="44,28 37,36.9 37.9,61.9 49.9,39"
                    fill="#969696"
                    stroke="#969696"
                    stroke-width="0.6"
                />
                <polygon
                    points="38.2,34.2 17,64.9 21.9,73.9 35.9,63.4 38.6,64.2 36.4,62"
                    fill="#626262"
                    stroke="#626262"
                    stroke-width="0.6"
                />
                <polygon
                    points="54.6,24.2 56,28 51,39 62,59.9 61.2,64.2 63.9,59 64,39"
                    fill="#626262"
                    stroke="#626262"
                    stroke-width="0.6"
                />
                <polygon
                    points="49.9,19 42.6,28.6 50,39 36.5,62 51,69.9 62.4,61.9 50.9,39 55.9,26.9"
                    fill="#7b7b7b"
                    stroke="#7b7b7b"
                    stroke-width="0.6"
                />
                <polygon
                    points="55.6,25.2 64,38.9 64,59 50.1,70.9 63,63.9 78.6,74.2 83.9,65.9"
                    fill="#505050"
                    stroke="#505050"
                    stroke-width="0.6"
                />
            </g>
        </svg>
    )
}

{
    company === "one" && (
        <svg
            class={className}
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 128 128"
            aria-hidden="true"
        >
            <path fill="#e7e2dc" d="M0 0h128v128H0z" />
            <path fill="#9db3c8" d="M48 16h64v112H48z" />
            <path fill="#788fa5" d="M16 80h32v48H16z" />
            <path fill="#56687a" d="M48 80h32v48H48z" />
        </svg>
    )
}
