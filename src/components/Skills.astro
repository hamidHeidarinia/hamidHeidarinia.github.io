---
import { useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
    locale: Locale;
    currentPath: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const currentLocale = Astro.currentLocale;
const homeUrl = getRelativeLocaleUrl(currentLocale, "/");
---

<!-- ============ SKILLS ============ -->
<div
    class="px-4 sm:px-8 md:px-16 py-6 sm:py-8 border-b border-slate-200 dark:border-slate-800 transition-colors duration-300"
>
    <div
        class="mb-6 focus-ring mt-5 sm:mt-6 flex items-center justify-between max-w-4xl transition group"
    >
        <a href={homeUrl} class="flex items-center gap-3">
            <svg
                class="rotate-180 w-6 h-6 text-slate-400 dark:fill-slate-300 group-hover:-translate-x-1 transition-transform shrink-0"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 512 512"
                ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                <path opacity=".4" fill="" d=""></path>
                <path
                    fill=""
                    d="M505 273c9.4-9.4 9.4-24.6 0-33.9L337 71c-9.4-9.4-24.6-9.4-33.9 0s-9.4 24.6 0 33.9l127 127-406.1 0c-13.3 0-24 10.7-24 24s10.7 24 24 24l406.1 0-127 127c-9.4 9.4-9.4 24.6 0 33.9s24.6 9.4 33.9 0L505 273z"
                ></path>
            </svg>
            <h1
                class="text-xl sm:text-3xl font-bold text-slate-900 dark:text-white"
            >
                {t("skills.title")} (34)
            </h1>
        </a>
    </div>

