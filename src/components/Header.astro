---
import { useTranslations } from "../i18n/utils";

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
import { Image } from "astro:assets";
import HeaderImg from "../assets/images/hamidHeidarinia-Header-page.webp";
import AvatarImg from "../assets/images/hamidHeidarinia-avatar.webp";
---

<!-- Component Template (HTML + JS Expressions) --><!-- ============ BANNER ============ -->
<div
    class="relative w-full h-[300px] xs:h-[220px] sm:h-[320px] md:h-[400px] overflow-hidden"
>
    <div
        class="w-full h-[250px] xs:h-[220px] sm:h-[260px] md:h-[320px] overflow-hidden dark:from-slate-800 dark:to-slate-900 transition-colors duration-300"
    >
        <!-- top-right controls: dark mode toggle + language selector -->
        <div
            class="absolute top-4 right-4 sm:top-6 sm:right-6 z-20 flex items-center gap-2"
        >
            <!-- dark mode toggle -->
            <button
                @click="dark = !dark"
                class="focus-ring flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 bg-white/95 dark:bg-slate-800/95 border border-slate-200 dark:border-slate-700 rounded-md shadow-sm hover:bg-white dark:hover:bg-slate-700 transition"
                :aria-label="dark ? 'Switch to light mode' : 'Switch to dark mode'"
            >
                <svg
                    x-show="!dark"
                    class="w-4 h-4 sm:w-[18px] sm:h-[18px] fill-slate-600"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <circle cx="12" cy="12" r="4"></circle>
                    <path
                        d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                    ></path>
                </svg>
                <svg
                    x-show="dark"
                    x-cloak
                    class="w-4 h-4 sm:w-[18px] sm:h-[18px] fill-amber-300"
                    viewBox="0 0 24 24"
                >
                    <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
                </svg>
            </button>

            <!-- language selector -->
            <div x-data="{ open: false, lang: 'EN' }" class="relative">
                <button
                    @click="open = !open"
                    class="focus-ring flex items-center gap-1 bg-white/95 dark:bg-slate-800/95 border border-slate-200 dark:border-slate-700 rounded-md px-2.5 py-1.5 sm:px-3 text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 shadow-sm hover:bg-white dark:hover:bg-slate-700 transition"
                >
                    <span x-text="lang"></span>
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        :class="open && 'rotate-180'"
                        class="transition-transform"
                    >
                        <path d="M6 9l6 6 6-6"></path>
                    </svg>
                </button>
                <div
                    x-show="open"
                    @click.outside="open = false"
                    x-cloak
                    x-transition
                    class="absolute right-0 mt-1 w-24 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md shadow-lg overflow-hidden"
                >
                    <button
                        @click="lang='EN'; open=false"
                        class="block w-full text-left px-3 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700"
                        >EN</button
                    >
                    <button
                        @click="lang='AZ'; open=false"
                        class="block w-full text-left px-3 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700"
                        >AZ</button
                    >
                    <button
                        @click="lang='AZ-Cyrl'; open=false"
                        class="block w-full text-left px-3 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700"
                        >AZ-Cyrl</button
                    >
                    <button
                        @click="lang='TR'; open=false"
                        class="block w-full text-left px-3 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700"
                        >TR</button
                    >
                    <button
                        @click="lang='تورکجه'; open=false"
                        class="block w-full text-left px-3 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700"
                        >تورکجه</button
                    >
                    <button
                        @click="lang='FA'; open=false"
                        class="block w-full text-left px-3 py-2 text-sm text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700"
                        >FA</button
                    >
                </div>
            </div>
        </div>

        <!-- desk illustration band -->
        <div
            style={`background-image: url(${HeaderImg.src})`}
            class="absolute w-full h-[250px] xs:h-[220px] sm:h-[260px] md:h-[320px] overflow-hidden dark:from-slate-800 dark:to-slate-900 transition-colors duration-300
            bg-cover
            bg-no-repeat
            lg:bg-[position:center_-11rem]
            md:bg-[position:center_-6rem]
            sm:bg-[position:center_-6rem]
            bg-[position:center]"
        >
        </div>
    </div>
    <!-- profile avatar -->
    <div
        class="absolute top-[12rem] sm:top-[11rem] md:top-[14rem] left-[2rem] sm:left-8 md:left-[4rem] z-10"
    >
        <div
            class="w-24 h-24 sm:w-32 sm:h-32 md:w-40 md:h-40 rounded-full bg-white dark:bg-slate-900 p-1 sm:p-1.5 shadow-lg transition-colors duration-300"
        >
            <div class="">
                <img
                    src={AvatarImg.src}
                    alt="profile image"
                    class="w-full h-full rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center overflow-hidden"
                />
            </div>
        </div>
    </div>
</div>

<!-- ============ HEADER INFO ============ -->
<div
    class="px-[1rem] sm:px-8 md:px-16 pb-6 sm:pb-8 border-b border-slate-200 dark:border-slate-800 transition-colors duration-300"
>
    <div
        class="flex flex-col md:flex-row md:justify-between md:items-start gap-6 md:gap-8"
    >
        <!-- left: name / title / actions -->
        <div class="min-w-0">
            <h1
                class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-800 dark:text-white leading-tight break-words"
            >
                {t("header.fullname")}
            </h1>
            <p
                class="text-sm sm:text-base md:text-xl text-slate-600 dark:text-slate-400 mt-1"
            >
                {t("header.headline")}
            </p>
            <div
                class="text-xs sm:text-sm md:text-lg text-slate-500 dark:text-slate-400 mt-1.5"
            >
                {t("header.location")}
                &nbsp;
                <svg
                    class="w-1 h-1 fill-gray-400 inline-block"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 672 672"
                    ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                    <path
                        fill=""
                        d="M56 336C56 181.4 181.4 56 336 56C490.6 56 616 181.4 616 336C616 490.6 490.6 616 336 616C181.4 616 56 490.6 56 336z"
                    ></path>
                </svg>
                &nbsp;
                <div
                    x-data="{ contactInfoModal: false }"
                    class="inline-block"
                    x-cloak
                >
                    <button
                        type="button"
                        class="text-blue-600 dark:text-blue-400 font-medium hover:underline"
                        @click="contactInfoModal = true"
                        @keyup.escape="contactInfoModal = false"
                    >
                        <p class="cursor-pointer">
                            {t("header.contact.info.btn.title")}
                        </p>
                    </button>
                    <!-- modal conten -->
                    <div
                        x-show="contactInfoModal"
                        x-cloak
                        tabindex="0"
                        class="z-50 inset-0 w-full h-full py-6 fixed flex justify-center items-center"
                    >
                        <div
                            @click.away="contactInfoModal = false"
                            class="z-50 relative p-3 mx-auto my-0 w-11/12 md:w-1/2"
                            x-show="contactInfoModal"
                            x-transition:enter="transition duration-500"
                            x-transition:enter-start="transform opacity-0 -translate-y-4"
                            x-transition:enter-end="transform opacity-100 translate-y-0"
                            x-transition:leave="transition -translate-y-4"
                            x-transition:leave-start="transform opacity-100 translate-y-0"
                            x-transition:leave-end="transform opacity-0 -translate-y-4"
                        >
                            <div
                                class="bg-white dark:bg-slate-950 dark:text-slate-300 rounded-2xl shadow-lg border border-gray-200 dark:border-slate-700 flex flex-col overflow-hidden"
                            >
                                <div
                                    class="flex flex-row justify-between items-center border-b border-gray-200 dark:border-slate-700 px-4 py-2 text-slate-800"
                                >
                                    <h2
                                        class="text-2xl font-bold text-slate-900 dark:text-slate-300"
                                    >
                                        {t("header.contact.info.btn.title")}
                                    </h2>
                                    <button
                                        @click="contactInfoModal = false"
                                        class="fill-current h-6 w-6 font-3xl font-bold"
                                    >
                                        <svg
                                            class="w-5 h-5 fill-current dark:fill-slate-300"
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 640 640"
                                            ><!--!Font Awesome Free 7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
                                            <path
                                                d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z"
                                            ></path>
                                        </svg>
                                    </button>
                                </div>

                                <!-- modal content -->
                                <div
                                    class="p-4 bg-white dark:bg-slate-800/95 dark:text-slate-300"
                                >
                                    <div class="px-6 py-5 space-y-6">
                                        <!-- LinkedIn -->
                                        <div class="flex items-start gap-4">
                                            <svg
                                                class="w-9 h-9 fill-slate-800 dark:fill-slate-300"
                                                xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 640 640"
                                                ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                                                <path
                                                    fill=""
                                                    d="M512 96L127.9 96C110.3 96 96 110.5 96 128.3L96 511.7C96 529.5 110.3 544 127.9 544L512 544C529.6 544 544 529.5 544 511.7L544 128.3C544 110.5 529.6 96 512 96zM231.4 480L165 480L165 266.2L231.5 266.2L231.5 480L231.4 480zM198.2 160C219.5 160 236.7 177.2 236.7 198.5C236.7 219.8 219.5 237 198.2 237C176.9 237 159.7 219.8 159.7 198.5C159.7 177.2 176.9 160 198.2 160zM480.3 480L413.9 480L413.9 376C413.9 351.2 413.4 319.3 379.4 319.3C344.8 319.3 339.5 346.3 339.5 374.2L339.5 480L273.1 480L273.1 266.2L336.8 266.2L336.8 295.4L337.7 295.4C346.6 278.6 368.3 260.9 400.6 260.9C467.8 260.9 480.3 305.2 480.3 362.8L480.3 480z"
                                                ></path>
                                            </svg>
                                            <div>
                                                <p
                                                    class="font-bold text-slate-900 leading-tight dark:text-slate-300"
                                                >
                                                    {
                                                        t(
                                                            "header.contact.info.linkedin",
                                                        )
                                                    }
                                                </p>
                                                <a
                                                    href="https://www.linkedin.com/in/hamidheidarinia/"
                                                    class="text-blue-600 hover:underline text-[15px]"
                                                    target="_blank"
                                                    >linkedin.com/in/hamidheidarinia</a
                                                >
                                            </div>
                                        </div>

                                        <!-- Website -->
                                        <div class="flex items-start gap-4">
                                            <svg
                                                class="w-7 h-7 fill-slate-800 dark:fill-slate-300"
                                                version="1.0"
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="512.000000pt"
                                                height="512.000000pt"
                                                viewBox="0 0 512.000000 512.000000"
                                                preserveAspectRatio="xMidYMid meet"
                                            >
                                                <g
                                                    transform="translate(0.000000,512.000000) scale(0.066667,-0.066667)"
                                                    stroke="none"
                                                >
                                                    <path
                                                        d="M5333 6950 c-242 -38 -449 -116 -630 -237 -187 -126 -1007 -954
                                                        -1021 -1033 -23 -126 28 -233 134 -281 157 -72 183 -55 699 456 386 383 456
                                                        446 550 495 834 431 1704 -421 1294 -1265 -99 -202 -1556 -1658 -1754 -1753
                                                        -371 -176 -771 -120 -1075 152 -192 172 -440 86 -440 -152 0 -104 27 -152 137
                                                        -244 511 -431 1229 -472 1778 -102 133 89 1617 1581 1708 1717 501 748 204
                                                        1793 -607 2138 -208 88 -577 141 -773 109z"
                                                    ></path>
                                                    <path
                                                        d="M3307 4934 c-206 -27 -457 -122 -632 -240 -133 -89 -1617 -1581
                                                        -1708 -1717 -386 -577 -306 -1382 183 -1854 485 -468 1262 -534 1827 -156 187
                                                        126 1007 954 1021 1033 23 126 -28 233 -134 281 -158 72 -183 55 -699 -457
                                                        -423 -420 -448 -442 -570 -502 -834 -409 -1680 437 -1274 1273 99 202 1556
                                                        1658 1754 1753 371 176 771 120 1075 -152 144 -129 312 -122 406 18 229 340
                                                        -582 808 -1249 720z"
                                                    ></path>
                                                </g>
                                            </svg>
                                            <div>
                                                <p
                                                    class="font-bold text-slate-900 leading-tight dark:text-slate-300"
                                                >
                                                    {
                                                        t(
                                                            "header.contact.info.website",
                                                        )
                                                    }
                                                </p>
                                                <span class="text-[15px]">
                                                    <a
                                                        href="https://hamidheidarinia.github.io/"
                                                        class="text-blue-600 hover:underline"
                                                        target="_blank"
                                                        >hamidheidarinia.github.io</a
                                                    >&nbsp;
                                                    <span class="text-gray-500"
                                                        >{
                                                            t(
                                                                "header.contact.info.website.for",
                                                            )
                                                        }</span
                                                    >
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Phone -->
                                        <div class="flex items-start gap-4">
                                            <svg
                                                class="w-7 h-7 fill-slate-800 rotate-90 dark:fill-slate-300"
                                                xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 512 512"
                                                ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                                                <path
                                                    fill=""
                                                    d="M351.8 25c7.8-18.8 28.4-28.9 48.1-23.5l5.5 1.5c64.6 17.6 119.8 80.2 103.7 156.4-37.1 175-174.8 312.7-349.8 349.8-76.3 16.2-138.8-39.1-156.4-103.7l-1.5-5.5c-5.4-19.7 4.7-40.3 23.5-48.1l97.3-40.5c16.5-6.9 35.6-2.1 47 11.8l38.6 47.2c70.3-34.9 126.8-93.3 159.3-164.9l-44.1-36.1c-13.9-11.3-18.6-30.4-11.8-47L351.8 25z"
                                                ></path>
                                            </svg>
                                            <div>
                                                <p
                                                    class="font-bold text-slate-900 leading-tight dark:text-slate-300"
                                                >
                                                    {
                                                        t(
                                                            "header.contact.info.phone",
                                                        )
                                                    }
                                                </p>
                                                <span
                                                    class="text-[15px] text-slate-900"
                                                >
                                                    <a
                                                        href="tel:+989141939686"
                                                        class="text-blue-600 hover:underline"
                                                        >+989141939686</a
                                                    >&nbsp;
                                                    <span class="text-gray-500"
                                                        >{
                                                            t(
                                                                "header.contact.info.phone.for",
                                                            )
                                                        }</span
                                                    >
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Email -->
                                        <div class="flex items-start gap-4">
                                            <svg
                                                class="w-9 h-9 fill-slate-800 dark:fill-slate-300"
                                                xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 640 640"
                                                ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                                                <path
                                                    d="M125.4 128C91.5 128 64 155.5 64 189.4C64 190.3 64 191.1 64.1 192L64 192L64 448C64 483.3 92.7 512 128 512L512 512C547.3 512 576 483.3 576 448L576 192L575.9 192C575.9 191.1 576 190.3 576 189.4C576 155.5 548.5 128 514.6 128L125.4 128zM528 256.3L528 448C528 456.8 520.8 464 512 464L128 464C119.2 464 112 456.8 112 448L112 256.3L266.8 373.7C298.2 397.6 341.7 397.6 373.2 373.7L528 256.3zM112 189.4C112 182 118 176 125.4 176L514.6 176C522 176 528 182 528 189.4C528 193.6 526 197.6 522.7 200.1L344.2 335.5C329.9 346.3 310.1 346.3 295.8 335.5L117.3 200.1C114 197.6 112 193.6 112 189.4z"
                                                ></path></svg
                                            >
                                            <div>
                                                <p
                                                    class="font-bold text-slate-900 leading-tight dark:text-slate-300"
                                                >
                                                    {
                                                        t(
                                                            "header.contact.info.email",
                                                        )
                                                    }
                                                </p>
                                                <span
                                                    class="text-[15px] text-slate-900"
                                                >
                                                    <a
                                                        href="mailto:heidarinia.hamid@gmail.com"
                                                        class="text-blue-600 hover:underline"
                                                        >heidarinia.hamid@gmail.com</a
                                                    >&nbsp;
                                                    <span class="text-gray-500"
                                                        >{
                                                            t(
                                                                "header.contact.info.phone.for",
                                                            )
                                                        }</span
                                                    >
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Birthday -->
                                        <div class="flex items-start gap-4">
                                            <svg
                                                class="w-9 h-9 fill-slate-800 dark:fill-slate-300"
                                                xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 640 640"
                                                ><!--!Font Awesome Free 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
