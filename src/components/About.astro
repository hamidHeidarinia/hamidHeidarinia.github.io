---
import { useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
const currentLocale = Astro.currentLocale;
interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const skillsUrl = getRelativeLocaleUrl(currentLocale, "skills");
---

<!-- ============ ABOUT ============ -->
<div
    class="px-4 sm:px-8 md:px-16 py-6 sm:py-8 border-b border-slate-200 dark:border-slate-800 transition-colors duration-300"
>
    <h2
        class="text-xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-3 sm:mb-4"
    >
        {t("about.title")}
    </h2>
    <div
        class="text-sm sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed space-y-4 max-w-4xl"
    >
        <p class="p-0 m-0">
            {t("about.text.part.one")}
        </p>
        <p class="p-0 m-0">
            {t("about.text.part.two")}
        </p>
        <p class="p-0 m-0">
            {t("about.text.part.three")}
        </p>
    </div>

    <!-- top skills box -->
    <div x-data="{ topSkillsModal: false }" class="w-full" x-cloak>
        <div
            class="focus-ring mt-5 sm:mt-6 flex items-center justify-between border border-slate-300 dark:border-slate-700 rounded-xl px-4 sm:px-5 py-3.5 sm:py-4 max-w-4xl hover:bg-slate-50 dark:hover:bg-slate-800 hover:border-slate-400 dark:hover:border-slate-600 transition group cursor-pointer"
            @click="topSkillsModal = true"
            @keyup.escape="topSkillsModal = false"
        >
            <div class="flex items-center gap-3 sm:gap-4 min-w-0">
                <svg
                    class="w-5 h-5 sm:w-7 sm:h-7 text-slate-500 dark:text-slate-400 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                >
                    <path d="M6 3h12l3 5-9 13L3 8z"></path>
                    <path d="M3 8h18M9 3l3 5 3-5M12 8l-2 13M12 8l2 13"></path>
                </svg>
                <div class="min-w-0">
                    <p
                        class="font-semibold text-slate-900 dark:text-white text-sm sm:text-lg"
                    >
                        {t("about.top.skills.title")}
                    </p>
                    <p
                        class="text-xs sm:text-base text-slate-500 dark:text-slate-400 truncate"
                    >
                        MariaDB • MySQL • Microsoft SQL Server • PostgreSQL
                    </p>
                </div>
            </div>
            <svg id=""
                class="arrowIcon w-5 h-5 fill-slate-500 dark:fill-slate-400 group-hover:translate-x-1 transition-transform shrink-0"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 512 512"
                ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                <path opacity=".4" d=""></path>
                <path
                    d="M505 273c9.4-9.4 9.4-24.6 0-33.9L337 71c-9.4-9.4-24.6-9.4-33.9 0s-9.4 24.6 0 33.9l127 127-406.1 0c-13.3 0-24 10.7-24 24s10.7 24 24 24l406.1 0-127 127c-9.4 9.4-9.4 24.6 0 33.9s24.6 9.4 33.9 0L505 273z"
                ></path>
            </svg>
        </div>
        <!-- modal conten -->
        <div
            x-show="topSkillsModal"
            x-cloak
            tabindex="0"
            class="z-50 inset-0 w-full h-full py-6 fixed flex justify-center items-center"
        >
            <div
                @click.away="topSkillsModal = false"
                class="z-50 relative p-3 mx-auto my-0 w-11/12 md:w-[60%]"
                x-show="topSkillsModal"
                x-transition:enter="transition duration-500"
                x-transition:enter-start="transform opacity-0 -translate-y-4"
                x-transition:enter-end="transform opacity-100 translate-y-0"
                x-transition:leave="transition -translate-y-4"
                x-transition:leave-start="transform opacity-100 translate-y-0"
                x-transition:leave-end="transform opacity-0 -translate-y-4"
            >
                <div
                    class="bg-white dark:bg-slate-950 dark:text-slate-300 rounded-2xl shadow-lg border border-gray-200 dark:border-slate-700 flex flex-col overflow-hidden"
                >
                    <div
                        class="flex flex-row justify-between items-center border-b border-gray-200 dark:border-slate-700 px-4 py-2 text-slate-800"
                    >
                        <h2
                            class="text-2xl font-bold text-slate-900 dark:text-slate-300"
                        >
                            {t("about.top.skills.modal.title")}
                        </h2>
                        <button
                            @click="topSkillsModal = false"
                            class="fill-current h-6 w-6 font-3xl font-bold"
                        >
                            <svg
                                class="w-5 h-5 fill-current dark:fill-slate-300"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 640 640"
                                ><!--!Font Awesome Free 7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
                                <path
                                    d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z"
                                ></path>
                            </svg>
                        </button>
                    </div>

                    <!-- modal content -->
                    <div
                        class="p-4 bg-white dark:bg-slate-800/95 dark:text-slate-300"
                    >
                        <div class="px-6 py-5 space-y-6">
                            <!-- Skill Item 1 -->
                            <div
                                class="pb-2 border-b border-gray-200"
                                x-data="{ open: false }"
                            >
                                <div
                                    class="flex flex-row justify-between items-center"
                                    :class="{ 'mb-4': open == false, 'mb-0': open == true}"
                                >
                                    <h2
                                        class="text-2xl font-bold text-slate-900 dark:text-white mb-2"
                                    >
                                        MariaDB
                                    </h2>
                                    <svg
                                        class="w-5 h-5 fill-current"
                                        xmlns="http://www.w3.org/2000/svg"
                                        :style="`transform: rotate(${open ? 180 : 0}deg); transition: transform 0.3s ease;`"
                                        @click="open = !open"
                                        viewBox="0 0 384 512"
                                        ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                                        <path opacity=".4" fill="" d=""></path>
                                        <path
                                            d="M180.7 148.7c6.2-6.2 16.4-6.2 22.6 0l160 160c6.2 6.2 6.2 16.4 0 22.6s-16.4 6.2-22.6 0L192 182.6 43.3 331.3c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6l160-160z"
                                        ></path>
                                    </svg>
                                </div>
                                <div
                                    class="flex items-center gap-2"
                                    x-show="!open"
                                >
                                    <svg
                                        class="w-7 h-7"
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 100 100"
                                        width="100"
                                        height="100"
                                    >
                                        <defs>
                                            <linearGradient
                                                id="bg"
                                                x1="0%"
                                                y1="0%"
                                                x2="100%"
                                                y2="0%"
                                            >
                                                <stop
                                                    offset="0%"
                                                    stop-color="#ff8a00"></stop>
                                                <stop
                                                    offset="48%"
                                                    stop-color="#f04432"></stop>
                                                <stop
                                                    offset="100%"
                                                    stop-color="#2832a8"></stop>
                                            </linearGradient>
                                        </defs>

                                        <rect
                                            x="4"
                                            y="4"
                                            width="92"
                                            height="92"
                                            rx="8"
                                            fill="url(#bg)"></rect>

                                        <!-- white logo -->
                                        <circle
                                            cx="50"
                                            cy="39"
                                            r="15"
                                            fill="none"
                                            stroke="#fff"
                                            stroke-width="7"></circle>
                                        <path
                                            d="M35 61
                                                                        C37 70, 43 75, 50 75
                                                                        C57 75, 63 70, 65 61"
                                            fill="none"
                                            stroke="#fff"
                                            stroke-width="7"
                                            stroke-linecap="butt"
                                            stroke-linejoin="round"></path>
                                    </svg>
                                    <p
                                        class="text-base text-gray-600 dark:text-slate-300 font-medium"
                                    >
                                        {
                                            t("experience.three.job.title")
                                        }&nbsp;at&nbsp;
                                        {t("experience.three.organization")}
                                    </p>
                                </div>
                            </div>
                            <!-- Skill Item 2 -->
                            <div
                                class="pb-2 border-b border-gray-200"
                                x-data="{ open: false }"
                            >
                                <div
                                    class="flex flex-row justify-between items-center"
                                    :class="{ 'mb-4': open == false, 'mb-0': open == true}"
                                >
                                    <h2
                                        class="text-2xl font-bold text-slate-900 dark:text-white mb-2"
                                    >
                                        MySQL
                                    </h2>
                                    <svg
                                        class="w-5 h-5 fill-current"
                                        xmlns="http://www.w3.org/2000/svg"
                                        :style="`transform: rotate(${open ? 180 : 0}deg); transition: transform 0.3s ease;`"
                                        @click="open = !open"
                                        viewBox="0 0 384 512"
                                        ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                                        <path opacity=".4" fill="" d=""></path>
                                        <path
                                            d="M180.7 148.7c6.2-6.2 16.4-6.2 22.6 0l160 160c6.2 6.2 6.2 16.4 0 22.6s-16.4 6.2-22.6 0L192 182.6 43.3 331.3c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6l160-160z"
                                        ></path>
                                    </svg>
                                </div>
                                <div
                                    class="flex items-center gap-2"
                                    x-show="!open"
                                >
                                    <svg
                                        class="w-7 h-7"
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 128 128"
                                        id="company-accent-4"
                                    >
                                        <path fill="#e7e2dc" d="M0 0h128v128H0z"
                                        ></path>
                                        <path
                                            fill="#9db3c8"
                                            d="M48 16h64v112H48z"></path>
                                        <path
                                            fill="#788fa5"
                                            d="M16 80h32v48H16z"></path>
                                        <path
                                            fill="#56687a"
                                            d="M48 80h32v48H48z"></path>
                                    </svg>
                                    <p
                                        class="text-base text-gray-600 dark:text-slate-300 font-medium"
                                    >
                                        {t("experience.one.job.title")} at {
                                            t("experience.one.organization")
                                        }
                                    </p>
                                </div>
                            </div>
                            <!-- Skill Item 3 -->
                            <div
                                class="pb-2 border-b border-gray-200"
                                x-data="{ open: false }"
                            >
                                <div
                                    class="flex flex-row justify-between items-center"
                                    :class="{ 'mb-4': open == false, 'mb-0': open == true}"
                                >
                                    <h2
                                        class="text-2xl font-bold text-slate-900 dark:text-white mb-2"
                                    >
                                        Microsoft SQL Server
                                    </h2>
                                    <svg
                                        class="w-5 h-5 fill-current"
                                        xmlns="http://www.w3.org/2000/svg"
                                        :style="`transform: rotate(${open ? 180 : 0}deg); transition: transform 0.3s ease;`"
                                        @click="open = !open"
                                        viewBox="0 0 384 512"
                                        ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                                        <path opacity=".4" fill="" d=""></path>
                                        <path
                                            d="M180.7 148.7c6.2-6.2 16.4-6.2 22.6 0l160 160c6.2 6.2 6.2 16.4 0 22.6s-16.4 6.2-22.6 0L192 182.6 43.3 331.3c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6l160-160z"
                                        ></path>
                                    </svg>
                                </div>
                                <div
                                    class="flex items-center gap-2"
                                    x-show="!open"
                                >
                                    <svg
                                        class="w-7 h-7"
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 100 100"
                                    >
                                        <circle cx="50" cy="50" r="50" fill=""
                                        ></circle>
                                        <g stroke-linejoin="round">
                                            <polygon
                                                points="44,28 37,36.9 37.9,61.9 49.9,39"
                                                fill="#969696"
                                                stroke="#969696"
                                                stroke-width="0.6"></polygon>
                                            <polygon
                                                points="38.2,34.2 17,64.9 21.9,73.9 35.9,63.4 38.6,64.2 36.4,62"
                                                fill="#626262"
                                                stroke="#626262"
                                                stroke-width="0.6"></polygon>
                                            <polygon
                                                points="54.6,24.2 56,28 51,39 62,59.9 61.2,64.2 63.9,59 64,39"
                                                fill="#626262"
                                                stroke="#626262"
                                                stroke-width="0.6"></polygon>
                                            <polygon
                                                points="49.9,19 42.6,28.6 50,39 36.5,62 51,69.9 62.4,61.9 50.9,39 55.9,26.9"
                                                fill="#7b7b7b"
                                                stroke="#7b7b7b"
                                                stroke-width="0.6"></polygon>
                                            <polygon
                                                points="55.6,25.2 64,38.9 64,59 50.1,70.9 63,63.9 78.6,74.2 83.9,65.9"
                                                fill="#505050"
                                                stroke="#505050"
                                                stroke-width="0.6"></polygon>
                                        </g>
                                    </svg>
                                    <!-- <svg class="w-9 h-9" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
                                                    <circle cx="50" cy="50" r="50" fill="#000" />
                                                
                                                    <path d="M16 67 L50 17 L84 67 L74 74 L50 48 L26 74 Z" fill="#555555" />
                                                
                                                    <path d="M16 67 L50 17 L50 48 L26 74 Z" fill="#666666" />
                                                
                                                    <path d="M50 17 L63 39 L50 65 L37 39 Z" fill="#8A8A8A" />
                                                
                                                    <path d="M50 17 L84 67 L74 74 L50 48 Z" fill="#4A4A4A" />
                                                
                                                    <path d="M37 39 L50 65 L63 39 L50 48 Z" fill="#707070" />
                                                </svg> -->
                                    <p
                                        class="text-base text-gray-600 dark:text-slate-300 font-medium"
                                    >
                                        {t("experience.two.job.title")} at {
                                            t("experience.two.organization")
                                        }
                                    </p>
                                </div>
                            </div>
                            <!-- Skill Item 4 -->
                            <div class="pb-2" x-data="{ open: false }">
                                <div
                                    class="flex flex-row justify-between items-center"
                                    :class="{ 'mb-4': open == false, 'mb-0': open == true}"
                                >
                                    <h2
                                        class="text-2xl font-bold text-slate-900 dark:text-white mb-2"
                                    >
                                        PostgreSQL
                                    </h2>
                                    <svg
                                        class="w-5 h-5 fill-current"
                                        xmlns="http://www.w3.org/2000/svg"
                                        :style="`transform: rotate(${open ? 180 : 0}deg); transition: transform 0.3s ease;`"
                                        @click="open = !open"
                                        viewBox="0 0 384 512"
                                        ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                                        <path opacity=".4" fill="" d=""></path>
                                        <path
                                            d="M180.7 148.7c6.2-6.2 16.4-6.2 22.6 0l160 160c6.2 6.2 6.2 16.4 0 22.6s-16.4 6.2-22.6 0L192 182.6 43.3 331.3c-6.2 6.2-16.4 6.2-22.6 0s-6.2-16.4 0-22.6l160-160z"
                                        ></path>
                                    </svg>
                                </div>
                                <div
                                    class="flex items-center gap-2"
                                    x-show="!open"
                                >
                                    <svg
                                        class="w-7 h-7"
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 100 100"
                                        width="100"
                                        height="100"
                                    >
                                        <defs>
                                            <linearGradient
                                                id="bg"
                                                x1="0%"
                                                y1="0%"
                                                x2="100%"
                                                y2="0%"
                                            >
                                                <stop
                                                    offset="0%"
                                                    stop-color="#ff8a00"></stop>
                                                <stop
                                                    offset="48%"
                                                    stop-color="#f04432"></stop>
                                                <stop
                                                    offset="100%"
                                                    stop-color="#2832a8"></stop>
                                            </linearGradient>
                                        </defs>

                                        <rect
                                            x="4"
                                            y="4"
                                            width="92"
                                            height="92"
                                            rx="8"
                                            fill="url(#bg)"></rect>

                                        <!-- white logo -->
                                        <circle
                                            cx="50"
                                            cy="39"
                                            r="15"
                                            fill="none"
                                            stroke="#fff"
                                            stroke-width="7"></circle>
                                        <path
                                            d="M35 61
                                                                                                                C37 70, 43 75, 50 75
                                                                                                                C57 75, 63 70, 65 61"
                                            fill="none"
                                            stroke="#fff"
                                            stroke-width="7"
                                            stroke-linecap="butt"
                                            stroke-linejoin="round"></path>
                                    </svg>
                                    <p
                                        class="text-base text-gray-600 dark:text-slate-300 font-medium"
                                    >
                                        {
                                            t("experience.three.job.title")
                                        }&nbsp;at&nbsp;
                                        {t("experience.three.organization")}
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div
                            class="w-full px-6 py-3 border-t border-gray-200 flex justify-end"
                        >
                            <a
                                href={skillsUrl}
                                class="transition group cursor-pointer m-auto flex flex-row gap-2 flex flex-row gap- items-center"
                            >
                                <b class=""
                                    >{t("about.top.skills.modal.link.title")}</b
                                >
                                <svg
                                    class="arrowIcon w-5 h-5 fill-slate-500 dark:fill-slate-400 group-hover:translate-x-1 transition-transform shrink-0"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 512 512"
                                    ><!--! Font Awesome Pro 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2026 Fonticons, Inc. -->
                                    <path opacity=".4" fill="" d=""></path>
                                    <path
                                        d="M505 273c9.4-9.4 9.4-24.6 0-33.9L337 71c-9.4-9.4-24.6-9.4-33.9 0s-9.4 24.6 0 33.9l127 127-406.1 0c-13.3 0-24 10.7-24 24s10.7 24 24 24l406.1 0-127 127c-9.4 9.4-9.4 24.6 0 33.9s24.6 9.4 33.9 0L505 273z"
                                    ></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
